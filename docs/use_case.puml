@startuml
left to right direction

actor "设备管理员" as Admin
actor "运维工程师" as Ops
actor "班组长" as Lead

rectangle "设备云监" {
  usecase "管理设备台账" as UC1
  usecase "查看实时监控" as UC2
  usecase "处理报警" as UC3
  usecase "处理工单" as UC4
  usecase "查看统计报表" as UC5
  usecase "管理备件" as UC6
  usecase "采集Modbus数据" as UC7
}

Admin --> UC1
Admin --> UC2
Ops --> UC2
Lead --> UC2
Ops --> UC3
Ops --> UC4
Lead --> UC4
Lead --> UC5
Admin --> UC6
Ops --> UC6

UC2 ..> UC7 : include
UC3 ..> UC7 : include

@enduml
